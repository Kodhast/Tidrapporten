rules_version = '2';

// Tidrapportens regler (ADR 0012, issue 15). Prototype: review before real data is stored.
//
// ===============================================================
// Assumed data model
// ===============================================================
//
// Everything lives under users/{uid}/…; only the owner (request.auth.uid == uid), signed in with
// the custom token the login Worker makes (ADR 0006), reads or writes. Any other way of signing in
// to the Firebase project is refused, even in the user's own tree.
// The users/{uid} document itself is not used. Every document carries:
//   - schemaVersion: int (>= 1)
//   - createdAt: timestamp (= request.time on create, immutable)
//   - updatedAt: timestamp (= request.time on every write)
// Days are strings 'YYYY-MM-DD', weeks 'YYYY-Www', clock times 'HH:MM'. Lengths are whole minutes.
//
// assignments/{id}: name string 1–100, startDate day, endDate day|null, terms list 1–50,
//   openingFlex int, standardDay list ≤ 20, archived bool, order int, lastChangeId string|null
// assignments/{id}/codes/{id}: name string 1–100, billable bool, archived bool, order int
// assignments/{id}/receivers/{id}: name string 1–100, position int ≥ 1, suggestionMode
//   'fillNorm'|'actualQuarter', codes list ≤ 100, mapping map ≤ 200 keys, archived bool,
//   lastChangeId string|null
// absenceTypes/{id}: name string 1–100, counting 'fillsNorm'|'flexWithdrawal'|'worked',
//   archived bool, order int, lastChangeId string|null
// freeDays/{day}: free bool, name string ≤ 100, lastChangeId string|null
// entries/{id}: assignmentId string, subject {kind 'code', codeId} | {kind 'absence',
//   absenceTypeId}, time {kind 'interval', start, end: timestamp, 0 < end − start ≤ 24 h} |
//   {kind 'allDay', date: day, only for absence}, note string ≤ 500. Interval times lie between
//   2020-01-01 and a year from now.
// pauses/{day}: only the common fields
// reports/{assignmentId_receiverId_week}: assignmentId, receiverId, week, status
//   'draft'|'sent'|'unlocked', mode, lines list ≤ 100, snapshot map|null (set when sent),
//   lastChangeId string|null
// changeLog/{id}: at timestamp (= request.time), path string ≤ 300, action
//   'create'|'update'|'delete'|'send'|'unlock', week week|null, before map|null, after map|null,
//   reason string ≤ 500, by 'app'. Create only; never updated or deleted.
// devices/{id}: fcmToken string 1–4096, label string ≤ 100
// state/timer: assignmentId, subject, start timestamp between 2020-01-01 and a day from now.
//   Deleted when the timer stops.
// state/settings: noTimerBy, timerRunningAt, reportReminderFridayAt: clock|null,
//   remindEmptyDay bool, flexWarning int ≥ 0
//
// Locking (ADR 0012): a sent report can only be unlocked; an unlocked report can be changed or
// sent again. Every such locked change writes a NEW changeLog entry in the same batch, named by
// the report's lastChangeId, whose path is the report's, with before, after and a reason that
// is not empty. A report that becomes sent carries the server time in snapshot.sentAt.
// Changes that alter the flex of weeks already counted (ADR 0016) need a new changeLog entry the
// same way, with before (on update) and after but a reason that may be empty: an assignment's
// openingFlex, startDate, endDate or terms, an absence type's counting, a receiver's position or
// a new receiver, and every create or update of a free day. Deleting a free day and corrections
// of entries in a sent week are logged by the app, not enforced here.
//
// Lists are checked for type and size only; rules cannot look inside every element. The data
// layer (src/data/) tolerates malformed elements when it reads.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'custom';
    }

    function data() {
      return request.resource.data;
    }

    function isDay(value) {
      return value is string && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    function isWeek(value) {
      return value is string && value.matches('^[0-9]{4}-W(0[1-9]|[1-4][0-9]|5[0-3])$');
    }

    function isClock(value) {
      return value is string && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function isId(value) {
      return value is string && value.size() <= 100 && value.matches('^[A-Za-z0-9-]+$');
    }

    function isName(value) {
      return value is string && value.size() > 0 && value.size() <= 100;
    }

    function isIdOrNull(value) {
      return value == null || isId(value);
    }

    // Interval times and the timer: not before the app existed, and not far ahead of now. An
    // interval may be planned (absence) up to a year ahead; the timer starts now.
    function isTimeFrom2020(value, ahead) {
      return value is timestamp && value >= timestamp.date(2020, 1, 1)
        && value <= request.time + ahead;
    }

    function isClockOrNull(value) {
      return value == null || isClock(value);
    }

    // The common fields on create: schemaVersion, and both times set by the server.
    function isValidCreateMeta() {
      return data().schemaVersion is int && data().schemaVersion >= 1
        && data().createdAt == request.time
        && data().updatedAt == request.time;
    }

    // The common fields on update: createdAt kept, updatedAt set by the server.
    function isValidUpdateMeta() {
      return data().schemaVersion is int && data().schemaVersion >= 1
        && data().createdAt == resource.data.createdAt
        && data().updatedAt == request.time;
    }

    function isValidMeta() {
      return resource == null ? isValidCreateMeta() : isValidUpdateMeta();
    }

    function fields(own) {
      return own.concat(['schemaVersion', 'createdAt', 'updatedAt']);
    }

    function hasExactly(own) {
      return data().keys().hasOnly(fields(own)) && data().keys().hasAll(fields(own));
    }

    function isValidSubject(subject) {
      return subject is map && (
        (subject.keys().hasOnly(['kind', 'codeId']) && subject.keys().hasAll(['kind', 'codeId'])
          && subject.kind == 'code' && isId(subject.codeId))
        || (subject.keys().hasOnly(['kind', 'absenceTypeId'])
          && subject.keys().hasAll(['kind', 'absenceTypeId'])
          && subject.kind == 'absence' && isId(subject.absenceTypeId))
      );
    }

    function isValidTime(time, subject) {
      return time is map && (
        (time.keys().hasOnly(['kind', 'start', 'end']) && time.keys().hasAll(['kind', 'start', 'end'])
          && time.kind == 'interval' && isTimeFrom2020(time.start, duration.value(366, 'd'))
          && time.end is timestamp
          && time.end > time.start && time.end <= time.start + duration.value(24, 'h'))
        || (time.keys().hasOnly(['kind', 'date']) && time.keys().hasAll(['kind', 'date'])
          && time.kind == 'allDay' && isDay(time.date) && subject.kind == 'absence')
      );
    }

    // ---------- Validators ----------

    function isValidAssignment() {
      return hasExactly(['name', 'startDate', 'endDate', 'terms', 'openingFlex', 'standardDay',
          'archived', 'order', 'lastChangeId'])
        && isName(data().name)
        && isDay(data().startDate)
        && (data().endDate == null || (isDay(data().endDate) && data().endDate >= data().startDate))
        && data().terms is list && data().terms.size() >= 1 && data().terms.size() <= 50
        && data().openingFlex is int
        && data().standardDay is list && data().standardDay.size() <= 20
        && data().archived is bool
        && data().order is int
        && isIdOrNull(data().lastChangeId);
    }

    function isValidCode() {
      return hasExactly(['name', 'billable', 'archived', 'order'])
        && isName(data().name)
        && data().billable is bool
        && data().archived is bool
        && data().order is int;
    }

    function isValidReceiver() {
      return hasExactly(['name', 'position', 'suggestionMode', 'codes', 'mapping', 'archived',
          'lastChangeId'])
        && isName(data().name)
        && data().position is int && data().position >= 1
        && data().suggestionMode in ['fillNorm', 'actualQuarter']
        && data().codes is list && data().codes.size() <= 100
        && data().mapping is map && data().mapping.size() <= 200
        && data().archived is bool
        && isIdOrNull(data().lastChangeId);
    }

    function isValidAbsenceType() {
      return hasExactly(['name', 'counting', 'archived', 'order', 'lastChangeId'])
        && isName(data().name)
        && data().counting in ['fillsNorm', 'flexWithdrawal', 'worked']
        && data().archived is bool
        && data().order is int
        && isIdOrNull(data().lastChangeId);
    }

    function isValidFreeDay(day) {
      return hasExactly(['free', 'name', 'lastChangeId'])
        && isDay(day)
        && data().free is bool
        && data().name is string && data().name.size() <= 100
        && isIdOrNull(data().lastChangeId);
    }

    function isValidEntry() {
      return hasExactly(['assignmentId', 'subject', 'time', 'note'])
        && isId(data().assignmentId)
        && isValidSubject(data().subject)
        && isValidTime(data().time, data().subject)
        && data().note is string && data().note.size() <= 500;
    }

    function isValidTimer() {
      return hasExactly(['assignmentId', 'subject', 'start'])
        && isId(data().assignmentId)
        && isValidSubject(data().subject)
        && isTimeFrom2020(data().start, duration.value(1, 'd'));
    }

    function isValidSettings() {
      return hasExactly(['noTimerBy', 'timerRunningAt', 'remindEmptyDay',
          'reportReminderFridayAt', 'flexWarning'])
        && isClockOrNull(data().noTimerBy)
        && isClockOrNull(data().timerRunningAt)
        && data().remindEmptyDay is bool
        && isClockOrNull(data().reportReminderFridayAt)
        && data().flexWarning is int && data().flexWarning >= 0;
    }

    function isValidDevice() {
      return hasExactly(['fcmToken', 'label'])
        && data().fcmToken is string && data().fcmToken.size() > 0
        && data().fcmToken.size() <= 4096
        && data().label is string && data().label.size() <= 100;
    }

    function isValidSnapshot(snapshot) {
      return snapshot is map
        && snapshot.keys().hasOnly(['sentAt', 'assignmentName', 'receiverName', 'codeNames',
          'actualMinutes'])
        && snapshot.keys().hasAll(['sentAt', 'assignmentName', 'receiverName', 'codeNames',
          'actualMinutes'])
        && snapshot.sentAt is timestamp
        && isName(snapshot.assignmentName)
        && isName(snapshot.receiverName)
        && snapshot.codeNames is map && snapshot.codeNames.size() <= 200
        && snapshot.actualMinutes is int;
    }

    function isValidReport(reportId) {
      return hasExactly(['assignmentId', 'receiverId', 'week', 'status', 'mode', 'lines',
          'snapshot', 'lastChangeId'])
        && isId(data().assignmentId)
        && isId(data().receiverId)
        && isWeek(data().week)
        && reportId == data().assignmentId + '_' + data().receiverId + '_' + data().week
        && data().status in ['draft', 'sent', 'unlocked']
        && data().mode in ['fillNorm', 'actualQuarter']
        && data().lines is list && data().lines.size() <= 100
        && (data().status == 'draft' || isValidSnapshot(data().snapshot))
        && (data().snapshot == null || isValidSnapshot(data().snapshot))
        && isIdOrNull(data().lastChangeId)
        && (data().status != 'sent' || data().snapshot.sentAt == request.time);
    }

    // The write names, by lastChangeId, a changeLog entry that is new in this batch, belongs to
    // this document (path below the user) and week, names the change and holds the document
    // after it, and before it on an update. A reused entry already exists and fails the first
    // check.
    function logAfter(uid) {
      return getAfter(/databases/$(database)/documents/users/$(uid)/changeLog/$(data().lastChangeId)).data;
    }

    function isLogged(uid, path, action, week) {
      let logPath = /databases/$(database)/documents/users/$(uid)/changeLog/$(data().lastChangeId);
      return isId(data().lastChangeId)
        && !exists(logPath)
        && existsAfter(logPath)
        && logAfter(uid).path == path
        && logAfter(uid).week == week
        && logAfter(uid).action == action
        && logAfter(uid).after != null
        && (resource == null || logAfter(uid).before != null);
    }

    // A locked report change also needs a reason.
    function isLoggedChange(uid, reportId, action) {
      return isLogged(uid, 'reports/' + reportId, action, data().week)
        && logAfter(uid).reason.trim().size() > 0;
    }

    // A change of a setting that alters the flex of weeks already counted (ADR 0016).
    function isLoggedSetting(uid, path) {
      return isLogged(uid, path, resource == null ? 'create' : 'update', null);
    }

    function changes(keys) {
      return resource != null && data().diff(resource.data).affectedKeys().hasAny(keys);
    }

    function isUnlock() {
      return resource.data.status == 'sent'
        && data().status == 'unlocked'
        && data().diff(resource.data).affectedKeys().hasOnly(['status', 'lastChangeId', 'updatedAt']);
    }

    // Allowed status changes. Draft is free; a sent report can only be unlocked; an unlocked
    // report can be changed or sent again. Everything except draft needs a new log entry.
    function isAllowedReportUpdate(uid, reportId) {
      let from = resource.data.status;
      let to = data().status;
      return (from == 'draft' && to in ['draft', 'sent'])
        || (isUnlock() && isLoggedChange(uid, reportId, 'unlock'))
        || (from == 'unlocked' && to in ['unlocked', 'sent']
          && isLoggedChange(uid, reportId, to == 'sent' ? 'send' : 'update'));
    }

    function isValidChangeLog() {
      return data().keys().hasOnly(['at', 'path', 'action', 'week', 'before', 'after', 'reason',
          'by', 'schemaVersion', 'createdAt', 'updatedAt'])
        && data().keys().hasAll(['at', 'path', 'action', 'week', 'before', 'after', 'reason',
          'by', 'schemaVersion', 'createdAt', 'updatedAt'])
        && isValidCreateMeta()
        && data().at == request.time
        && data().path is string && data().path.size() > 0 && data().path.size() <= 300
        && data().action in ['create', 'update', 'delete', 'send', 'unlock']
        && (data().week == null || isWeek(data().week))
        && (data().before == null || (data().before is map && data().before.size() <= 50))
        && (data().after == null || (data().after is map && data().after.size() <= 50))
        && data().reason is string && data().reason.size() <= 500
        && data().by == 'app';
    }

    // ---------- Paths ----------

    match /users/{uid} {
      // Nothing is stored in the user document itself.
      allow read, write: if false;

      match /assignments/{assignmentId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidMeta() && isValidAssignment()
          && (!changes(['openingFlex', 'startDate', 'endDate', 'terms'])
            || isLoggedSetting(uid, 'assignments/' + assignmentId));
        allow delete: if false; // issue 26

        match /codes/{codeId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid) && isValidMeta() && isValidCode();
          allow delete: if false;
        }

        match /receivers/{receiverId} {
          allow read: if isOwner(uid);
          // A new receiver may take position 1, so creating one is logged too.
          allow create, update: if isOwner(uid) && isValidMeta() && isValidReceiver()
            && ((resource != null && !changes(['position']))
              || isLoggedSetting(uid, 'assignments/' + assignmentId + '/receivers/' + receiverId));
          allow delete: if false;
        }
      }

      match /absenceTypes/{typeId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidMeta() && isValidAbsenceType()
          && (!changes(['counting']) || isLoggedSetting(uid, 'absenceTypes/' + typeId));
        allow delete: if false;
      }

      match /freeDays/{day} {
        allow read, delete: if isOwner(uid);
        // Deleting a free day cannot name a log entry; the app logs it (ADR 0016).
        allow create, update: if isOwner(uid) && isValidMeta() && isValidFreeDay(day)
          && isLoggedSetting(uid, 'freeDays/' + day);
      }

      match /entries/{entryId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidMeta() && isValidEntry();
      }

      match /pauses/{day} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isDay(day) && isValidMeta() && hasExactly([]);
      }

      match /reports/{reportId} {
        allow read: if isOwner(uid);
        // A new report starts as a draft or is sent at once; neither is a locked change.
        allow create: if isOwner(uid) && isValidCreateMeta() && isValidReport(reportId)
          && data().status in ['draft', 'sent'];
        allow update: if isOwner(uid) && isValidUpdateMeta() && isValidReport(reportId)
          && isAllowedReportUpdate(uid, reportId);
        allow delete: if isOwner(uid) && resource.data.status == 'draft';
      }

      match /changeLog/{changeId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && isValidChangeLog();
        allow update, delete: if false;
      }

      match /devices/{deviceId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidMeta() && isValidDevice();
      }

      match /state/timer {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidMeta() && isValidTimer();
      }

      match /state/settings {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidMeta() && isValidSettings();
        allow delete: if false;
      }
    }
  }
}
