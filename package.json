{
	"name": "tidrapporten",
	"private": true,
	"version": "1.5.1",
	"description": "Tidrapportering för en IT-konsult: faktisk tid, veckorapporter och flex",
	"type": "module",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"check": "tsc -b",
		"lint": "prettier --check . && eslint . --max-warnings 0",
		"format": "prettier --write .",
		"icons": "node scripts/make-icons.mjs",
		"test": "vitest --run --coverage",
		"test:e2e": "npm run build:functions && firebase emulators:exec --only auth,firestore,functions --project demo-tidrapporten \"playwright test\"",
		"test:rules": "firebase emulators:exec --only auth,firestore --project demo-tidrapporten \"vitest --run --config vitest.emulator.config.ts\"",
		"build:functions": "vite build --config vite.functions.config.ts",
		"verify": "npm run check && npm run lint && npm run test"
	},
	"dependencies": {
		"@kodhast/web-ui": "github:Kodhast/web-ui#v2.3.0",
		"@kodhast/web-ui-react": "github:Kodhast/web-ui-react#v0.10.0",
		"firebase": "^13.4.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"allowScripts": {
		"esbuild": true,
		"@firebase/util": false,
		"protobufjs": false,
		"re2": false
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@firebase/rules-unit-testing": "^6.0.0",
		"@google-cloud/billing": "^6.2.0",
		"@playwright/test": "^1.65.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.13",
		"@types/node": "^24.19.4",
		"@types/react": "^19.3.2",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"@vitest/coverage-v8": "^5.1.2",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react-hooks": "^7.1.1",
		"firebase-admin": "^14.5.1",
		"firebase-functions": "^7.4.0",
		"firebase-tools": "^15.37.0",
		"globals": "^17.14.0",
		"jsdom": "^31.0.1",
		"prettier": "^3.10.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.74.0",
		"vite": "^8.3.8",
		"vite-plugin-pwa": "^2.0.0",
		"vitest": "^5.1.2",
		"workbox-core": "^7.4.1",
		"workbox-precaching": "^7.4.1",
		"workbox-routing": "^7.4.1"
	}
}
