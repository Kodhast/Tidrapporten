{
	"name": "tidrapporten",
	"private": true,
	"version": "0.1.0",
	"description": "Tidrapportering för en IT-konsult: faktisk tid, veckorapporter och flex",
	"type": "module",
	"engines": {
		"node": ">=22.13"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"check": "tsc -b",
		"lint": "prettier --check . && eslint . --max-warnings 0",
		"format": "prettier --write .",
		"icons": "node scripts/make-icons.mjs",
		"test": "vitest --run --coverage",
		"test:e2e": "playwright test",
		"verify": "npm run check && npm run lint && npm run test"
	},
	"dependencies": {
		"@kodhast/web-ui": "github:Kodhast/web-ui#v2.0.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"allowScripts": {
		"esbuild": true
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.1",
		"@types/node": "^24.19.4",
		"@types/react": "^19.3.2",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"@vitest/coverage-v8": "^5.1.2",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.74.0",
		"vite": "^8.3.8",
		"vite-plugin-pwa": "^2.0.0",
		"vitest": "^5.1.2"
	}
}
